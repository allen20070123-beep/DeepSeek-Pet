// dsh-pet 配置（JSONC：允许 // 和 /* */ 注释）
// 说明：浏览器端启动时通过 /dsh-pet-7340/config.jsonc 拉取；任何字段缺失/写错都会
//       回退到 client.js 的代码默认值，不会导致插件崩溃。
{
  // ===================== 系统通知总开关 =====================
  // 对话完成 / 生成失败 / 输出截断 / 权限申请 / 用户选择 在窗口失焦时弹出系统级通知（桌面右下角）。
  // 不需要时改为 false（修改后刷新或重启生效）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.json）顶层覆盖，设置页保存宠物时会保留该字段。
  "notificationsEnabled": true,
  // ===================== 默认宠物列表（多开） =====================
  // pets 数组定义默认宠物；「设置页 → 添加宠物」的默认模板取 pets[0]（main）。
  // 每个宠物独立：id（标识）、size（宽度 px，高度自动 = size × 9/16）、
  // balanceEnabled（是否启用余额功能：true=触发余额动画+显示余额气泡；false=该宠物完全禁用。
  //   必填布尔值，缺失即配置错误）、position（corner: 四角之一；marginX/marginY: 距所属角落偏移 px）
  "pets": [
    {
      "id": "main",
      "size": 462,
      "balanceEnabled": true,
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],

  // ===================== 动作动画池配置 =====================
  "animations": {
    // 小克 v0 占位动画：由正式三视图（正/侧/背）程序化生成（呼吸、转身、跳跃、花瓣等），
    // 待 AI 生成的正式动画做好后，按同名替换 assets/webm 下的文件或改这里的动画名即可。
    // 待机动画池（数组，可放多个，等概率抽）
    "idle": ["小克-待机呼吸"],
    // 转向动画池（每一项都必须是“播完会翻转朝向”的动画）
    "turn": ["小克-回头张望"],
    // 拖拽动画池（被无形抓起悬空的姿势）
    "drag": ["小克-被拎起"],
    // 点击回应动画池（点按宠物时触发，随机抽 1 个）
    "clicks": ["小克-开心跳跃", "小克-转圈展示", "小克-害羞摇晃", "小克-向日葵绽放"],
    // 移动动画池：minDist/maxDist 以基准宠物宽 462px 为准，按实际大小等比缩放；
    // leadSec/tailSec = 动画首尾原地不动的秒数（小克的走路动画首尾各约 2 秒在正面站立）
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "小克-轻步走" },
        { "name": "小克-小跑", "params": { "minDist": 120, "maxDist": 320 } }
      ]
    },
    // 随机动作分类池：weight 为出现权重，合计 = 100 − idle − turn − move
    "categories": [
      { "id": "小动作", "weight": 40, "actions": ["小克-轻轻摇摆", "小克-优雅转身", "小克-花瓣飘落"] },
      { "id": "玩耍", "weight": 40, "actions": ["小克-向日葵环绕", "小克-连跳"] }
    ],
    // 事件动画：只由代码显式触发。balance = Token 余量 6 档（已用百分比 0-20-40-60-80-100）
    "events": {
      "balance": [
        "小克-余量充足",   // 0 ≤ p < 20
        "小克-余量宽裕",   // 20 ≤ p < 40
        "小克-余量如常",   // 40 ≤ p < 60
        "小克-余量偏少",   // 60 ≤ p < 80
        "小克-余量告急",   // 80 ≤ p < 100
        "小克-余量用尽"    // p === 100
      ]
    }
  },

  // ===================== 事件触发周期 =====================
  // 事件名 → 刷新间隔（秒）。balance（余额）：余额数据刷新 + 余额动画触发的间隔，
  // 启动时立即触发一次，之后按此周期循环。非法数值（非正数/非数字）即配置错误。
  "eventsRefreshSec": {
    "balance": 1800
  },

  // ===================== 动画链顶层权重 =====================
  // idle/turn/move 的权重 + 上面各分类 weight 合计 = 100
  // 当前：10 + 5 + 5 + (40+40=80) = 100
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}
